# ===================================================================
# DMF Website Backend - Environment Configuration Template
# ===================================================================
# Copy this file to '.env' in the backend/ directory.
# NEVER commit the actual '.env' file to Git or version control.
# ===================================================================

# -------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# -------------------------------------------------------------------
# Port on which the Express server listens. Defaults to 5000.
PORT=5000

# Node Environment: 'production' or 'development'
NODE_ENV=production

# -------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (REQUIRED IN PRODUCTION)
# -------------------------------------------------------------------
# MongoDB Connection URI (e.g., MongoDB Atlas connection string)
# If missing, backend startup will intentionally abort.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dmfmop?retryWrites=true&w=majority

# -------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (REQUIRED IN PRODUCTION)
# -------------------------------------------------------------------
# Cryptographically random secret key used to sign and verify JWT tokens.
# Must be at least 32 characters (256-bit).
# Generate on server: openssl rand -hex 32
# If missing, backend startup will intentionally abort.
JWT_SECRET=

# Google reCAPTCHA v2 / v3 Secret Key.
# Used on the server to verify form submissions (Admissions, Joinees, CSR).
# If missing, backend startup will intentionally abort.
RECAPTCHA_SECRET_KEY=

# -------------------------------------------------------------------
# 4. CORS CONFIGURATION (REQUIRED IN PRODUCTION)
# -------------------------------------------------------------------
# Comma-separated list of allowed web origins (no spaces).
# If missing, defaults to http://localhost:5173, which will block production requests.
ALLOWED_ORIGINS=https://dmfmop.org,https://www.dmfmop.org,http://localhost:5173
