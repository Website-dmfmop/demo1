# ===================================================================
# DMF Website Frontend - Environment Configuration Template
# ===================================================================
# Copy this file to '.env' in the project root directory.
# NEVER commit the actual '.env' file to Git or version control.
# ===================================================================

# Frontend API Base URL (Optional)
# In development: Automatically defaults to 'http://localhost:5000'
# In production:  Automatically defaults to '' (same-origin relative paths /api and /uploads)
# Only set VITE_API_URL if explicitly hosting the API on a separate external domain/subdomain.
VITE_API_URL=

# Google reCAPTCHA v2 / v3 Site Key (Client-side)
VITE_RECAPTCHA_SITE_KEY=
